# --- Server ---
HTTP_ADDR=:8080
ENV=dev
LOG_LEVEL=info

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Bearer token required by /admin/* endpoints.
ADMIN_TOKEN=change-me-please

# Shared HMAC secret cho /api/internal/* — crawler ký request bằng giá trị này.
# Bắt buộc nếu chạy crawler service. Để trống = endpoint /api/internal/* trả 503.
CRAWLER_SECRET=change-me-too

# --- Database (PostgreSQL) ---
# Format: postgres://user:pass@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cooking_recipe?sslmode=disable

# --- Redis (Asynq queue) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- External clients ---
YOUTUBE_API_KEY=
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_PROVIDER=openai           # openai | local
OPENAI_WHISPER_MODEL=whisper-1

# --- Pipeline runtime ---
YT_DLP_PATH=yt-dlp
AUDIO_TMP_DIR=/tmp/cooking-recipe-audio

# --- Frontend revalidation hook ---
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_SECRET=change-me-too
